{
  "name": "nextpier",
  "version": "0.1.0",
  "description": "Next.js workbench starter for agents with AnimateIcons, Cult UI, Wails, and app-harness AI chat.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yayapao/nextpier.git"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "wails",
    "desktop-app",
    "starter-template",
    "animateicons",
    "cult-ui",
    "shadcn-ui",
    "app-harness",
    "ai-agent"
  ],
  "scripts": {
    "dev": "next dev --port 3900",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:cli": "node --test scripts/tests/*.test.mjs",
    "test:desktop-template": "node scripts/tests/check-wails-template.mjs",
    "test:harness-template": "node scripts/tests/check-harness-template.mjs",
    "init:project": "node scripts/init.mjs",
    "upgrade:wails": "node scripts/desktop.mjs upgrade",
    "upgrade:harness": "node scripts/harness.mjs upgrade",
    "harness:prepare": "node scripts/harness.mjs prepare"
  },
  "dependencies": {
    "@animateicons/react": "^0.6.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.95.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.0.1",
    "motion": "^12.38.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tar": "^7.5.7",
    "typescript": "^5"
  },
  "volta": {
    "node": "24.9.0"
  }
}
